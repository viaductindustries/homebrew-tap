class Ghsecretsync < Formula
  desc "Sync 1Password fields to GitHub Actions secrets and variables"
  homepage "https://github.com/viaductindustries/github-secret-sync"
  url "https://github.com/viaductindustries/github-secret-sync/releases/download/v@VERSION@/ghsecretsync_@VERSION@_source.tar.gz"
  sha256 "@SHA256@"

  depends_on "go" => :build
  depends_on "gh"

  def install
    system "go", "build", *std_go_args(ldflags: "-s -w")
  end

  def caveats
    <<~EOS
      Requires 1Password CLI 2, which is distributed as a cask:
        brew install --cask 1password-cli
    EOS
  end

  test do
    assert_match "-dry-run", shell_output("#{bin}/ghsecretsync --help 2>&1")
    output = shell_output("#{bin}/ghsecretsync --repo octo/example --org octo 2>&1", 1)
    assert_match "--repo and --org cannot be used together", output
  end
end
